# PostgreSQL + PostGIS connection string
DATABASE_URL=postgresql://cincin:cincin123@localhost:5432/cincin

# Google Places API — used to seed venue name/address/website data
GOOGLE_PLACES_API_KEY=

# Groq — used by the extraction pipeline to parse unstructured
# venue text/menus into structured happy hour data
GROQ_API_KEY=

# Gemini — used by the scraper to read happy hour info off of photographed
# menu images when detect_pattern finds an "image_menu" pattern
GEMINI_API_KEY=
